// Allocation-attribution fixture (attribution category, D-385/D-386): native
// calls plus array growth. Same 1,000-iteration shape as attr-native.grob, but
// the native call is xs.append(i) instead of "x".upper(), which also grows the
// backing GrobArray via doubling.
xs: int[] := []
for i in 1..1000 {
    xs.append(i)
}
