<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Grob.Torture</RootNamespace>
    <AssemblyName>Grob.Torture</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Tooling: not packaged, not part of the product. Nothing under src/ references it (D-451). -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The oracle drives the pipeline in process (D-451 Decision 1), so it references the
       pipeline's assemblies directly. Not Grob.Cli: the oracle builds its own catalogue
       over fake capabilities through StdlibCatalogue.Build. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Grob.Core\Grob.Core.csproj" />
    <ProjectReference Include="..\..\src\Grob.Runtime\Grob.Runtime.csproj" />
    <ProjectReference Include="..\..\src\Grob.Compiler\Grob.Compiler.csproj" />
    <ProjectReference Include="..\..\src\Grob.Vm\Grob.Vm.csproj" />
    <ProjectReference Include="..\..\src\Grob.Stdlib\Grob.Stdlib.csproj" />
  </ItemGroup>

  <!-- One extractor, not two (prompt §1.3): the public samples gate's block extractor and the
       register reader are linked from Grob.Integration.Tests, which this project must not
       reference. They keep their own namespaces, an exception to namespaces-follow-folders. -->
  <ItemGroup>
    <Compile Include="..\..\tests\Grob.Integration.Tests\PublicSamples\SampleExtractor.cs" Link="Linked\SampleExtractor.cs" />
    <Compile Include="..\..\tests\Grob.Integration.Tests\PublicSamples\SampleBlock.cs" Link="Linked\SampleBlock.cs" />
    <Compile Include="..\..\tests\Grob.Integration.Tests\ErrorExamples\ErrorExampleMaster.cs" Link="Linked\ErrorExampleMaster.cs" />
    <Compile Include="..\..\tests\Grob.Integration.Tests\ErrorExamples\DeferredWorkRegister.cs" Link="Linked\DeferredWorkRegister.cs" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Grob.Torture.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
