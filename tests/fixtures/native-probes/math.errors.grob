// Native-call probe corpus: math namespace, error probes (D-426 Decision 5, condition 2).
// Captured against b202509 before any signature work. Do not regenerate the expected
// file to match new output: a difference is a defect in the migration, not in the gold
// master. Probe kinds per member: wrong arity, wrong argument type, nullable argument
// for a non-nullable parameter, return type pinned by a mismatched annotation.
f := 2.0
nf: float? := nil
i := 3
ni: int? := nil
s := "abc"

// unknown member
math.nope()
math.nope

// math.pi / math.e / math.tau: constants
math.pi()
math.e()
math.tau()
