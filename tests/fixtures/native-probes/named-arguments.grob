// Native-call probe corpus: named arguments to natives. First captured against b202509,
// when natives refused every name. Natives now bind on the script-function convention
// (D-113): a required parameter named is E0009, an unknown name E0011 and a call leaving
// a required parameter unbound E0003, naming it. Lines 17 and 26 bind cleanly. Change
// the expected file only for a deliberate change in behaviour, never to match new output.
f := 2.0
i := 3
s := "abc"
arr := ["a", "b"]
d := date.now()
g := guid.newV4()

// namespace natives
math.sqrt(x: 2.0)
math.sqrt(n: f)
math.pow(base: f, exp: f)
date.parse(s, pattern: s)
date.parse(pattern: s)
strings.join(parts: arr, separator: s)
guid.newV5(g, name: s)
int.min(a: i, b: i)
path.join(parts: s)

// primitive instance members
s.padLeft(width: i)
s.padLeft(i, char: s)
s.replace(from: s, to: s)
i.format(pattern: s)
f.roundTo(decimals: i)

// named-type instance members (accepted without a diagnostic before R-20)
d.addDays(days: i)
d.format(pattern: s)
d.isBefore(other: d)
d.toZone(zoneId: s)
