// Native-call probe corpus: Match instance members (named type), error probes (D-426
// Decision 5, condition 2; added with the module by D-440). Do not regenerate the
// expected file to match new output. Probe kinds per member: wrong arity, wrong argument
// type, nullable argument for a non-nullable parameter, nullable receiver through '.',
// return type pinned by a mismatched annotation.
i := 3
s := "abc"
ns: string? := nil
m := regex.matchAll(s, s)[0]
nm := regex.match(s, s)

// unknown member
m.nope()
m.nope

// value: string (property)
m.value()
nm.value
rvalue: int := m.value

// index: int (property)
m.index()
rindex: string := m.index

// length: int (property)
m.length()
rlength: string := m.length

// groups: string[] (property)
m.groups()
rgroups: string := m.groups
rgroupItem: int := m.groups[0]

// group(name: string): string?
m.group()
m.group(s, s)
m.group(i)
m.group(ns)
nm.group(s)
rgroup: string := m.group(s)
