// Native-call probe corpus: date instance members (named type), error probes (D-426
// Decision 5, condition 2). Captured against b202509 before any signature work. Do not
// regenerate the expected file to match new output. Probe kinds per member: wrong
// arity, wrong argument type (including a different named type where the parameter is
// the type's own), nullable argument for a non-nullable parameter, nullable receiver
// through '.', return type pinned by a mismatched annotation.
f := 2.5
i := 3
ni: int? := nil
s := "abc"
ns: string? := nil
d := date.now()
nd: date? := nil
g := guid.newV4()

// unknown member
d.nope()
d.nope

// year: int (property)
d.year()
nd.year
ryear: string := d.year

// month: int (property)
d.month()
nd.month
rmonth: string := d.month

// day: int (property)
d.day()
nd.day
rday: string := d.day

