// Native-call probe corpus: string instance members, error probes (D-426 Decision 5,
// condition 2). Captured against b202509 before any signature work. Do not regenerate
// the expected file to match new output. Probe kinds per member: wrong arity, wrong
// argument type, nullable argument for a non-nullable parameter, nullable receiver
// through '.', return type pinned by a mismatched annotation.
f := 2.5
i := 3
ni: int? := nil
s := "abc"
ns: string? := nil

// unknown member
s.nope()
s.nope

// length: int (property)
s.length()
ns.length
rlength: string := s.length

// isEmpty: bool (property)
