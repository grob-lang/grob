<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Grob.DriftCheck</RootNamespace>
    <AssemblyName>Grob.DriftCheck</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Tooling: not packaged, not part of the product solution graph. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Reads the live OpCode / TokenKind / ErrorCatalog facts to check them
       against the design corpus. The defaulted-parameter-name check (R-55) also
       reads the registered signatures from the stdlib catalogue, and array sort's
       view from the compiler. This is tooling outside the src/ DAG; nothing in
       src/ references it. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Grob.Core\Grob.Core.csproj" />
    <ProjectReference Include="..\..\src\Grob.Runtime\Grob.Runtime.csproj" />
    <ProjectReference Include="..\..\src\Grob.Compiler\Grob.Compiler.csproj" />
    <ProjectReference Include="..\..\src\Grob.Stdlib\Grob.Stdlib.csproj" />
  </ItemGroup>

</Project>
